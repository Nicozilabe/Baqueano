# Local build secrets for `baq drive` (Google Drive sync).
#
# Copy this file to `.env` and fill in the Client ID and Client Secret of a
# Google Cloud OAuth client of type "Desktop app"
# (https://console.cloud.google.com/apis/credentials). `.env` is gitignored.
#
# The values are embedded into the binary at build time so that
# `baq drive login` does not ask for credentials. On CI/releases these come
# from the GitHub Actions secrets BAQUEANO_GOOGLE_CLIENT_ID / BAQUEANO_GOOGLE_CLIENT_SECRET.
BAQUEANO_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
BAQUEANO_GOOGLE_CLIENT_SECRET=xxxxxxxx
